# Copy this file to application-local.yml and activate the local profile.
# application-local.yml is ignored by Git and may contain machine-local values.
spring:
  ai:
    dashscope:
      api-key: replace-with-your-dashscope-api-key-or-leave-empty

sky:
  upload-dir: ./uploads
  file-host: http://localhost:8081
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: sky_take_out
    username: root
    password: replace-with-your-local-password
  redis:
    host: localhost
    port: 6379
    database: 0
    password:
  jwt:
    admin-secret-key: replace-with-a-random-admin-secret-at-least-32-bytes
    user-secret-key: replace-with-a-random-user-secret-at-least-32-bytes
  wechat:
    appid:
    secret:
