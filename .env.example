# Runtime profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sky_take_out
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# JWT: use long, random and different values
JWT_ADMIN_SECRET=replace-with-a-random-admin-secret-at-least-32-bytes
JWT_USER_SECRET=replace-with-a-random-user-secret-at-least-32-bytes

# Spring AI / DashScope (optional; blank uses the local fallback)
AI_DASHSCOPE_API_KEY=

# WeChat integration (optional for local development)
WECHAT_APP_ID=
WECHAT_SECRET=

# File upload
UPLOAD_DIR=./uploads
FILE_HOST=http://localhost:8081
